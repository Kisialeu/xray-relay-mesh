# Example htpasswd file for Nginx basic auth (httpd-auth module)
# Format: username:$apr1$hash$salt (for password 'testpass' with round-robin salt, use 'htpasswd -B')
# Generated with: htpasswd -cB .htpasswd admin --password='YourSecurePasswordHere'

admin:$apr1$m8X9kQ7L$856520354053304354198293681385394542052103

# To rotate credentials:
#   htpasswd -B .htpasswd <new_user> --password='NewPassword'
# Place generated file at deploy-time, gitignore'd (do NOT commit)
